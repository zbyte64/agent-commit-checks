{
  "name": "agent-commit-checks",
  "version": "0.1.1",
  "description": "Model-backed checks on the commits a coding agent is about to push",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbyte64/agent-commit-checks.git"
  },
  "homepage": "https://github.com/zbyte64/agent-commit-checks#readme",
  "bugs": {
    "url": "https://github.com/zbyte64/agent-commit-checks/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "omp",
    "pi",
    "git",
    "pre-push",
    "code-review"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "acc": "bin/acc"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./src/adapters/omp/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/adapters/pi/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "smol-toml": "^1.3.1"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@types/bun": "^1.2.0",
    "onnxruntime-node": "^1.31.1",
    "typebox": "^1.4.3",
    "typescript": "^5.8.0"
  }
}
